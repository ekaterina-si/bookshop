{
  "extends": ["eslint:recommended", "plugin:prettier/recommended"],
  "plugins": ["pug"],
  "overrides": [
    {
      "files": ["*.pug"],
      "processor": "pug/pug"
    }
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2021": true
  },
  "rules": {
    "prettier/prettier": "error"
  }
}
